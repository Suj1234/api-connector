        explode_path={{ usage.aggregate.explode_path|py }},
        user_key_path={{ usage.aggregate.user_key_path|py }},
        time_path={{ usage.aggregate.time_path|py }},
        window_days={{ usage.aggregate.window_days }},
        metrics={{ usage.aggregate.metrics|py }},
