    # 5. Pagination for {{ s.name }}: {{ s.pagination.type }}
    def fetch_{{ s.name }}(self) -> list[Any]:
        path = h.fill({{ s.path|py }}, self.vars, self.now, encode=True)
        params = h.fill_query({{ s.query|py }}, self.vars, self.now)
        cap = self.limits.get("{{ s.name }}_pages")
        restarted = False
        while True:
            try:
                return self._pages_{{ s.name }}(path, params, cap)
            except ConnectorError as error:
                # A cursor that stopped working mid-way (expired): start over once, then give up.
                if error.code != "CURSOR_EXPIRED" or restarted:
                    raise
                restarted = True
                self.pages["{{ s.name }}"] = 0

    def _pages_{{ s.name }}(self, path: str, params: list[tuple[str, str]], cap: int | None) -> list[Any]:
        rows: list[Any] = []
        previous: str | None = None
{%- if s.pagination.type == "cursor" %}
        seen: set[str] = set()
        cursor: str | None = None
{%- elif s.pagination.type in ("next_url", "link_header") %}
        seen: set[str] = set()
        next_url: str | None = None
{%- elif s.pagination.type == "offset_limit" %}
        offset = 0
{%- elif s.pagination.type == "page_number" %}
        page = {{ s.pagination.start }}
{%- endif %}
        while True:
            if cap is not None and self.pages["{{ s.name }}"] >= cap:
                self.warnings.append("{{ s.name }}_capped")
                return rows
{%- if s.pagination.type == "cursor" %}
            page_params = params + ([({{ s.pagination.request_param|py }}, cursor)] if cursor else [])
            response = self._page("{{ s.name }}", path, page_params, cursor is not None)
{%- elif s.pagination.type in ("next_url", "link_header") %}
            response = (
                self._page("{{ s.name }}", next_url, None, True)
                if next_url
                else self._page("{{ s.name }}", path, params, False)
            )
{%- elif s.pagination.type == "offset_limit" %}
            page_params = params + [
                ({{ s.pagination.offset_param|py }}, str(offset)),
                ({{ s.pagination.limit_param|py }}, "{{ s.pagination.limit }}"),
            ]
            response = self._page("{{ s.name }}", path, page_params, offset > 0)
{%- elif s.pagination.type == "page_number" %}
            page_params = params + [({{ s.pagination.page_param|py }}, str(page))]
            response = self._page("{{ s.name }}", path, page_params, page != {{ s.pagination.start }})
{%- else %}
            response = self._page("{{ s.name }}", path, params, False)
{%- endif %}
            body = self._json(response)
            page_rows = h.records({{ s.records_path|py }}, body)
            self.pages["{{ s.name }}"] += 1
            # Paging guard: the same page twice means the paging parameter is being ignored.
            fingerprint = json.dumps(page_rows, sort_keys=True, default=str)
            if page_rows and fingerprint == previous:
                raise ConnectorError("PAGINATION_LOOP")
            previous = fingerprint
            rows.extend(page_rows)
{%- if s.pagination.type == "none" %}
            return rows
{%- elif s.pagination.type == "cursor" %}
{%- if s.pagination.get("has_more_path") %}
            if h.search({{ s.pagination.has_more_path|py }}, body) is not True:
                return rows
{%- endif %}
            next_cursor = h.search({{ s.pagination.next_cursor_path|py }}, body)
            if next_cursor is None or next_cursor == "":
                return rows
            cursor = str(next_cursor)
            if cursor in seen:
                raise ConnectorError("PAGINATION_LOOP")
            seen.add(cursor)
{%- elif s.pagination.type == "next_url" %}
            found = h.search({{ s.pagination.next_url_path|py }}, body)
            if not isinstance(found, str) or not found:
                return rows
            next_url = found
            if next_url in seen:
                raise ConnectorError("PAGINATION_LOOP")
            seen.add(next_url)
{%- elif s.pagination.type == "link_header" %}
            found = response.links.get("next", {}).get("url")
            if not found:
                return rows
            next_url = str(found)
            if next_url in seen:
                raise ConnectorError("PAGINATION_LOOP")
            seen.add(next_url)
{%- elif s.pagination.type == "offset_limit" %}
            if len(page_rows) < {{ s.pagination.limit }}:
                return rows
            offset += {{ s.pagination.limit }}
{%- elif s.pagination.type == "page_number" %}
            if not page_rows:
                return rows
            page += 1
{%- endif %}
{% endfor %}
    def _page(
        self, step: str, path_or_url: str, params: list[tuple[str, str]] | None, follow_up: bool
    ) -> httpx.Response:
        try:
            return self.request(step, path_or_url, params)
        except ConnectorError as error:
            # A follow-up page that suddenly fails as a bad request means the cursor stopped working.
            if follow_up and error.code == "WRONG_REQUEST":
                raise ConnectorError("CURSOR_EXPIRED", error.status) from None
            raise


# 3. Users: map each record to the platform's canonical user fields.
def map_user(record: Any) -> dict[str, Any]:
    return {
{%- for f in field_map %}
{%- if f.kind == "path" %}
        {{ f.target|py }}: h.search({{ f.path|py }}, record),
{%- elif f.kind == "lookup" %}
        {{ f.target|py }}: h.lookup(h.search({{ f.path|py }}, record), {{ f.map|py }}, {{ f.default|py }}),
{%- else %}
        {{ f.target|py }}: {{ f.const|py }},
{%- endif %}
{%- endfor %}
    }


def get_users(client: Client) -> list[dict[str, Any]]:
    return [map_user(record) for record in client.fetch_users()]


