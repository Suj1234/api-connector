# Copy to .env and fill in. Never commit .env. Never set GOOGLE_API_KEY.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL_DRAFT=gemini-3.8-flash
LLM_MODEL_ESCALATE=gemini-4-argon
LLM_INPUT_TOKEN_BUDGET=60000
DOCS_MAX_PAGES=60
VAULT_KEY=
