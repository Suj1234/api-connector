# Copy to .env and fill in. Never commit .env. Never set GOOGLE_API_KEY.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL_DRAFT=gemini-3.8-flash
LLM_MODEL_ESCALATE=gemini-4-argon
LLM_INPUT_TOKEN_BUDGET=60000
DOCS_MAX_PAGES=60
VAULT_KEY=
DATABASE_URL=sqlite:///./data/app.db
SANDBOX_MODE=docker
RUN_MODE_DEFAULT=live

# Live test accounts (milestone 4). Used by tests/live and `python -m app.tools.record <app>`.
# EXPECTED_USERS = the user count on each app's own admin screen.
CALENDLY_TOKEN=
CALENDLY_EXPECTED_USERS=
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_EXPECTED_USERS=
NOTION_TOKEN=
NOTION_EXPECTED_USERS=
